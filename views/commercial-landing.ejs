<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<%- include('partials/gtm-head') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#041f45">
  <title><%= h1 %> | سلام دکتر</title>
  <meta name="description" content="<%= subheadline %>">
  <link rel="canonical" href="<%= canonical %>">
  <meta name="robots" content="noindex, follow">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            navy: '#041f45',
            trust: '#1294e0',
            growth: '#0d9488',
            gold: '#c9a227',
            ink: '#13233c',
            muted: '#5f6f86',
            line: '#dbe4ee'
          },
          fontFamily: { vazir: ['Vazirmatn', 'Tahoma', 'sans-serif'] },
          boxShadow: {
            hero: '0 32px 64px -12px rgba(4, 31, 69, 0.25)',
            card: '0 12px 32px rgba(4, 31, 69, 0.08)'
          }
        }
      }
    };
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <% if (jsonLd) { %>
  <script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>
  <% } %>
  <script>window.__LANDING_SKAG__ = <%- skagJson %>;</script>
</head>
<body class="font-vazir bg-slate-50 text-ink antialiased">
<%- include('partials/gtm-body') %>

<div class="fixed bottom-0 inset-x-0 z-50 md:hidden bg-white/95 backdrop-blur border-t border-line p-3 shadow-[0_-8px_24px_rgba(0,0,0,0.08)]">
  <div class="flex gap-2 max-w-lg mx-auto">
    <button type="button" class="flex-1 text-center py-3 rounded-xl bg-growth text-white font-bold text-sm" data-skag="cta-primary" data-open-lead-form><%= ctaPrimary %></button>
    <% if (phone) { %>
    <a href="tel:<%= phone.replace(/\s/g, '') %>" class="px-4 py-3 rounded-xl border border-trust text-trust font-bold text-sm" aria-label="تماس"><i class="fa-solid fa-phone"></i></a>
    <% } %>
  </div>
</div>

<header class="bg-white/80 backdrop-blur-md border-b border-line sticky top-0 z-40">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
    <div class="min-w-0">
      <p class="font-extrabold text-navy truncate"><%= clinicName %></p>
      <p class="text-xs text-muted truncate"><%= city %> · پلتفرم سلام دکتر</p>
    </div>
    <% if (phone) { %>
    <a href="tel:<%= phone.replace(/\s/g, '') %>" class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-full bg-navy text-white text-sm font-bold">
      <i class="fa-solid fa-phone-volume text-gold text-xs"></i> تماس فوری
    </a>
    <% } %>
  </div>
</header>

<main class="pb-24 md:pb-0">
  <section class="relative overflow-hidden bg-gradient-to-b from-slate-900 via-navy to-[#0a2d5c] text-white">
    <div class="relative max-w-6xl mx-auto px-4 pt-10 pb-16 md:pt-16 md:pb-24">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div>
          <div class="flex flex-wrap gap-2 mb-5">
            <% trustBadges.forEach(function(badge) { %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 border border-white/15 text-xs font-semibold text-blue-50">
              <i class="fa-solid fa-circle-check text-growth text-[10px]"></i><%= badge %>
            </span>
            <% }); %>
          </div>
          <h1 id="skag-h1" class="text-3xl sm:text-4xl font-extrabold leading-[1.35] mb-5" data-default="<%= defaultH1 %>"><%= h1 %></h1>
          <p class="text-base md:text-lg text-blue-100/90 leading-relaxed mb-8 max-w-xl"><%= subheadline %></p>
          <div class="flex flex-col sm:flex-row gap-3">
            <button type="button" class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-2xl bg-gradient-to-l from-gold to-[#e8c84a] text-navy font-extrabold text-lg shadow-hero" data-skag="cta-primary" data-open-lead-form>
              <i class="fa-solid fa-bolt"></i><span><%= ctaPrimary %></span>
            </button>
            <a href="#pricing" class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-2xl border-2 border-white/25 font-bold hover:bg-white/10 transition" data-skag="cta-secondary"><%= ctaSecondary %></a>
          </div>
          <% if (address) { %>
          <p class="mt-6 text-sm text-blue-100/70 flex items-start gap-2">
            <i class="fa-solid fa-location-dot text-gold mt-0.5"></i><span><%= address %></span>
          </p>
          <% } %>
        </div>
        <div class="relative aspect-[4/5] sm:aspect-square max-w-md mx-auto rounded-3xl overflow-hidden shadow-hero border border-white/10">
          <img src="<%= heroImage %>" alt="<%= clinicName %>" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high">
        </div>
      </div>
    </div>
  </section>

  <section id="pricing" class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-2xl font-extrabold text-navy mb-2">شفافیت قیمت</h2>
      <p class="text-muted mb-8">برآورد شفاف هزینه درمان — هر آیتم زیر جداگانه قابل بررسی است.</p>
      <div class="grid md:grid-cols-2 gap-6">
        <% pricingPackages.forEach(function(pkg) { %>
        <article class="rounded-2xl border <%= pkg.highlight ? 'border-growth shadow-card ring-2 ring-growth/20' : 'border-line' %> p-6 bg-slate-50/50">
          <h3 class="text-lg font-bold text-navy mb-2"><%= pkg.name %></h3>
          <p class="text-2xl font-extrabold text-growth mb-1"><%= pkg.total %></p>
          <% if (pkg.perSession) { %><p class="text-sm text-muted mb-4"><%= pkg.perSession %></p><% } %>
          <ul class="space-y-2 text-sm">
            <% (pkg.items || []).forEach(function(item) { %>
            <li class="flex justify-between gap-3 border-b border-line/60 pb-2">
              <span><%= item.label %></span>
              <span class="font-semibold text-navy"><%= item.amount %></span>
            </li>
            <% }); %>
          </ul>
        </article>
        <% }); %>
      </div>
      <p class="text-xs text-muted mt-6 leading-relaxed"><%= pricingFootnote %></p>
    </div>
  </section>

  <section class="py-16 bg-gradient-to-br from-navy via-navy to-trust text-white">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-2xl md:text-3xl font-extrabold mb-4">همین امروز اولین قدم را بردارید</h2>
      <p class="text-blue-100/90 mb-8 leading-relaxed"><%= subheadline %></p>
      <button type="button" class="px-8 py-4 rounded-2xl bg-gold text-navy font-extrabold text-lg shadow-lg" data-skag="cta-primary" data-open-lead-form><%= ctaPrimary %></button>
    </div>
  </section>
</main>

<footer class="bg-navy text-blue-100/70 py-8 text-center text-sm">
  <p>clinic_id=<%= clinicId %> · package=<%= packageSlug %> · سلام دکتر</p>
</footer>

<!-- Lead capture modal -->
<div id="lead-modal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/50 p-4" aria-hidden="true">
  <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-xl" role="dialog" aria-labelledby="lead-modal-title">
    <div class="flex items-center justify-between mb-4">
      <h2 id="lead-modal-title" class="text-lg font-extrabold text-navy">رزرو نوبت / مشاوره</h2>
      <button type="button" id="lead-modal-close" class="text-muted hover:text-navy" aria-label="بستن">&times;</button>
    </div>
    <form id="lead-form" class="space-y-4" novalidate>
      <div>
        <label class="block text-sm font-semibold mb-1" for="lead-name">نام و نام خانوادگی</label>
        <input id="lead-name" name="name" required maxlength="120" class="w-full rounded-xl border border-line px-4 py-3" autocomplete="name">
      </div>
      <div>
        <label class="block text-sm font-semibold mb-1" for="lead-phone">شماره موبایل</label>
        <input id="lead-phone" name="phone" required inputmode="tel" pattern="09[0-9]{9}" class="w-full rounded-xl border border-line px-4 py-3" placeholder="09xxxxxxxxx" autocomplete="tel">
      </div>
      <div>
        <label class="block text-sm font-semibold mb-1" for="lead-desc">توضیحات (اختیاری)</label>
        <textarea id="lead-desc" name="desc" rows="3" maxlength="2000" class="w-full rounded-xl border border-line px-4 py-3"></textarea>
      </div>
      <p id="lead-form-error" class="hidden text-sm text-red-600"></p>
      <p id="lead-form-success" class="hidden text-sm text-growth font-semibold"></p>
      <button type="submit" class="w-full py-3 rounded-xl bg-growth text-white font-bold" data-skag="cta-primary"><%= ctaPrimary %></button>
    </form>
  </div>
</div>

<script src="/assets/js/commercial-landing.js" defer></script>
</body>
</html>
