<%
  // ========================================================================
  // _platform-backlink.ejs  —  MANDATORY platform attribution backlink.
  // Requirement #4: PageRank distribution from every dedicated clinic site.
  //
  // Two enforcement layers (defence in depth):
  //   1. APP-LEVEL (this partial): server-rendered clinic micro-sites MUST
  //      include it, e.g.  <%- include('_platform-backlink', { backlink: {
  //        href: 'https://salam-doctor.ir/shiraz/hair-transplant',
  //        text: 'بهترین کلینیک کاشت مو شیراز' } }) %>
  //   2. EDGE-LEVEL (nginx sub_filter, deploy/clinic-proxy.conf): injects the
  //      same link into EVERY text/html response for a clinic domain, so it
  //      survives even if a tenant edits or omits it in their own markup.
  // ========================================================================
  var backlink = (typeof backlink !== 'undefined' && backlink) || {};
  var blHref = backlink.href || 'https://salam-doctor.com/shiraz/beauty';
  var blText = backlink.text || 'بهترین کلینیک زیبایی شیراز';
%>
<footer class="salam-doctor-attribution" role="contentinfo"
        style="text-align:center;padding:16px;font:14px/1.7 Tahoma,sans-serif;background:#0f172a;color:#94a3b8">
  <a href="<%= blHref %>" rel="dofollow" title="<%= blText %>"
     style="color:#38bdf8;font-weight:700;text-decoration:none"><%= blText %></a>
</footer>
