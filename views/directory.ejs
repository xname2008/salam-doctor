<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<%- include('partials/gtm-head') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#1294e0">
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>">
  <link rel="canonical" href="<%= seo.canonical %>">
  <% if (typeof noindex !== 'undefined' && noindex) { %>
  <meta name="robots" content="noindex, follow">
  <% } else { %>
  <meta name="robots" content="index, follow, max-image-preview:large">
  <% } %>

  <meta property="og:type" content="website">
  <meta property="og:locale" content="fa_IR">
  <meta property="og:site_name" content="سلام دکتر">
  <meta property="og:title" content="<%= seo.title %>">
  <meta property="og:description" content="<%= seo.description %>">
  <meta property="og:url" content="<%= seo.canonical %>">
  <meta property="og:image" content="<%= seo.ogImage %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= seo.title %>">
  <meta name="twitter:description" content="<%= seo.description %>">
  <meta name="twitter:image" content="<%= seo.ogImage %>">

  <!-- Sitewide Organization + WebSite (SearchAction) — consistent brand identity across every hub page -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://salam-doctor.com/#organization",
        "name": "سلام دکتر",
        "alternateName": "Salam Doctor",
        "url": "https://salam-doctor.com/",
        "logo": { "@type": "ImageObject", "url": "https://salam-doctor.com/images/logo-heart.svg" },
        "sameAs": ["https://ble.ir/salamdoctoradmin"]
      },
      {
        "@type": "WebSite",
        "@id": "https://salam-doctor.com/#website",
        "name": "سلام دکتر",
        "alternateName": "Salam Doctor",
        "url": "https://salam-doctor.com/",
        "inLanguage": "fa-IR",
        "publisher": { "@id": "https://salam-doctor.com/#organization" },
        "potentialAction": {
          "@type": "SearchAction",
          "target": { "@type": "EntryPoint", "urlTemplate": "https://salam-doctor.com/search?q={search_term_string}" },
          "query-input": "required name=search_term_string"
        }
      }
    ]
  }
  </script>

  <!-- Structured data: single @graph (Product+rating, BreadcrumbList, ItemList, FAQPage) -->
  <script type="application/ld+json"><%- seo.jsonLd %></script>

  <link rel="preload" href="/assets/fonts/IRANSansXFaNum-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/tailwind.min.css">
  <link rel="stylesheet" href="/assets/css/shared.css?v=20260903b">

  <style>
    body{font-family:"Vazirmatn","IRANSansXFaNum","Tahoma",sans-serif}
    .star-on{color:#f59e0b}.star-off{color:#e2e8f0}
    .badge-verify{background:linear-gradient(135deg,#16a34a,#15803d);box-shadow:0 2px 8px rgba(22,163,74,.35)}
    .card-premium{border:2px solid #fbbf24;background:linear-gradient(180deg,#fffbeb 0%,#fff 40%)}
    .tbl-row:hover{background:#f8fafc}
    .tbl-sort{cursor:pointer;user-select:none}
    .tbl-sort:hover{color:#1294e0}
    details summary{list-style:none}
    details summary::-webkit-details-marker{display:none}
    .hub-seo-prose p{margin:0 0 1rem}
    .hub-seo-prose p:last-child{margin-bottom:0}
    .hub-seo-prose h2,.hub-seo-prose h3,.hub-seo-prose h4{
      font-weight:800;color:#0f172a;margin:1.25rem 0 .75rem;line-height:1.45
    }
    .hub-seo-prose h2{font-size:1.15rem}
    .hub-seo-prose h3{font-size:1.05rem}
    .hub-seo-prose ul,.hub-seo-prose ol{margin:0 0 1rem;padding-inline-start:1.25rem}
    .hub-seo-prose li{margin:.35rem 0}
    .hub-seo-prose a{color:#1294e0;font-weight:600;text-decoration:underline}
    .hub-seo-prose strong{color:#0f172a}
  </style>
</head>
<body class="bg-slate-50 text-slate-900 antialiased">
<%- include('partials/gtm-body') %>

  <header class="topbar sticky top-0 z-50 bg-white border-b border-slate-200 shadow-sm">
    <div class="container topbar-row max-w-6xl mx-auto px-4 min-h-[68px] flex items-center justify-between gap-3">
      <a href="/index.html" class="brand flex items-center gap-2 font-extrabold text-lg text-slate-900" aria-label="سلام دکتر — صفحه اصلی">
        <span class="logo logo-heart-beat w-10 h-10 rounded-xl bg-sky-500 text-white grid place-items-center font-bold" aria-hidden="true">
          <img src="/images/logo-heart.svg" alt="" width="28" height="28" loading="eager">
        </span>
        <span class="brand-name">سلام دکتر</span>
      </a>
      <a href="tel:+989007000462" class="inline-flex items-center justify-center rounded-xl bg-sky-500 hover:bg-sky-600 text-white font-bold text-sm px-4 py-2.5 transition-colors">مشاوره رایگان</a>
    </div>
  </header>

  <section class="bg-gradient-to-b from-white to-teal-50/60 border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 py-8 md:py-10">
      <%- seo.breadcrumbHtml || '' %>

      <h1 class="text-2xl md:text-4xl font-extrabold text-slate-900 leading-tight mb-3">
        <%= seo.h1Title %>
      </h1>
      <p class="text-slate-600 text-base md:text-lg max-w-3xl leading-relaxed mb-5"><%= seo.description %></p>

      <% if (service.parent) { %>
        <p class="mb-4">
          <a href="/<%= citySlug || 'shiraz' %>/<%= service.parent.slug %>" class="inline-flex items-center rounded-full bg-sky-50 border border-sky-200 px-3 py-1 text-xs font-bold text-sky-700 hover:bg-sky-100 transition-colors">
            دسته: <%= service.parent.name %>
          </a>
        </p>
      <% } %>

      <%
        var rv = stats.ratingValue;
        var fullStars = Math.floor(rv);
      %>
      <div class="inline-flex flex-wrap items-center gap-2 rounded-full bg-white border border-slate-200 px-4 py-2 text-sm shadow-sm">
        <span class="star-on text-base tracking-wide" aria-label="امتیاز <%= rv %> از ۵">
          <% for (var si = 1; si <= 5; si++) { %><span class="<%= si <= fullStars ? 'star-on' : 'star-off' %>">★</span><% } %>
        </span>
        <strong class="text-slate-800"><%= rv %></strong>
        <span class="text-slate-500">(<%= stats.reviewCount %> نظر)</span>
      </div>

      <dl class="grid grid-cols-3 gap-3 md:gap-6 mt-6 max-w-xl">
        <div class="bg-white rounded-xl border border-slate-200 p-3 text-center">
          <dt class="text-xs text-slate-500">مراکز</dt>
          <dd class="text-xl md:text-2xl font-bold text-sky-600"><%= stats.total %></dd>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-3 text-center">
          <dt class="text-xs text-slate-500">فعال</dt>
          <dd class="text-xl md:text-2xl font-bold text-sky-600"><%= stats.active %></dd>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-3 text-center">
          <dt class="text-xs text-slate-500">دستگاه اصل</dt>
          <dd class="text-xl md:text-2xl font-bold text-emerald-600"><%= stats.withAuthenticDevice %></dd>
        </div>
      </dl>

      <% if (service.children && service.children.length) { %>
        <nav class="flex flex-wrap gap-2 mt-5" aria-label="زیرخدمات">
          <% service.children.forEach(function(ch) { %>
            <a href="/shiraz/<%= ch.slug %>" class="text-xs md:text-sm font-semibold px-3 py-1.5 rounded-full bg-white border border-slate-200 hover:border-sky-400 hover:text-sky-600 transition-colors"><%= ch.name %></a>
          <% }) %>
        </nav>
      <% } %>
    </div>
  </section>

  <main class="max-w-6xl mx-auto px-4 py-8 md:py-12">

    <% if (!clinics.length) { %>
      <section class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 md:p-12 text-center text-slate-600" aria-live="polite">
        <p class="text-lg font-semibold text-slate-800">در حال حاضر مرکزی با ثبت مستقیم «<%= service.name %>» نداریم.</p>
        <p class="mt-3 text-sm leading-relaxed">صفحه راهنمای <%= service.name %> در <%= city %> با سوالات متداول و مراکز مرتبط پوست و زیبایی به‌روز نگه داشته می‌شود.</p>
      </section>

      <% if (relatedClinics && relatedClinics.length) { %>
        <section class="mt-10" aria-labelledby="related-clinics-heading">
          <span class="inline-block mb-3 text-xs font-extrabold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-full px-3 py-1.5">
            سایر کلینیک‌های معتبر پوست و زیبایی <%= city %>
          </span>
          <h2 id="related-clinics-heading" class="text-xl md:text-2xl font-bold text-slate-900 mb-4">مراکز مرتبط</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            <% relatedClinics.forEach(function(c) { %>
              <%- include('_clinic-card', { c: c, premium: c.isActive }) %>
            <% }) %>
          </div>
        </section>
      <% } %>

      <aside class="mt-10 rounded-2xl bg-slate-900 text-white p-6 md:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h2 class="text-lg md:text-xl font-bold mb-1">پزشک یا مدیر کلینیک هستید؟</h2>
          <p class="text-slate-300 text-sm">ثبت اطلاعات در سلام دکتر و معرفی مرکز خود به مراجعان جستجوگر.</p>
        </div>
        <a href="/clinic-promote.html" class="inline-flex shrink-0 items-center justify-center rounded-xl bg-sky-500 hover:bg-sky-400 text-white font-bold px-6 py-3 transition-colors">ثبت اطلاعات در سلام دکتر</a>
      </aside>
    <% } else { %>

      <!-- Summary table (desktop + scroll on mobile) -->
      <section class="mb-10" aria-labelledby="compare-heading">
        <h2 id="compare-heading" class="text-xl md:text-2xl font-bold text-slate-900 mb-4">مقایسه سریع مراکز</h2>
        <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
          <table id="clinic-table" class="w-full min-w-[640px] text-sm text-right">
            <caption class="sr-only">جدول مقایسه مراکز <%= service.name %> در <%= city %></caption>
            <thead class="bg-slate-50 text-slate-600 border-b border-slate-200">
              <tr>
                <th scope="col" class="tbl-sort px-4 py-3 font-bold" data-sort="name">نام مرکز ↕</th>
                <th scope="col" class="tbl-sort px-4 py-3 font-bold" data-sort="district">منطقه ↕</th>
                <th scope="col" class="px-4 py-3 font-bold">دستگاه تأییدشده</th>
                <th scope="col" class="tbl-sort px-4 py-3 font-bold" data-sort="rating">امتیاز ↕</th>
                <th scope="col" class="px-4 py-3 font-bold hidden sm:table-cell">وضعیت</th>
              </tr>
            </thead>
            <tbody>
              <% clinics.forEach(function(c, idx) {
                var districtName = c.district ? c.district.name : '—';
                var authDevices = c.devices.filter(function(d){ return d.isAuthentic; }).map(function(d){ return d.brandName; }).join('، ') || '—';
              %>
              <tr class="tbl-row border-b border-slate-100 last:border-0"
                  data-name="<%= c.name %>"
                  data-district="<%= districtName %>"
                  data-rating="<%= c.rating.value %>"
                  data-premium="<%= c.isActive ? 1 : 0 %>">
                <td class="px-4 py-3 font-semibold text-slate-800">
                  <a href="<%= c.profileUrl %>" class="hover:text-sky-600"><%= c.name %></a>
                </td>
                <td class="px-4 py-3 text-sky-700 font-medium"><%= districtName %></td>
                <td class="px-4 py-3 text-emerald-700 text-xs md:text-sm"><%= authDevices %></td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <span class="star-on text-xs"><% var tf=Math.floor(c.rating.value); for(var t=1;t<=5;t++){ %><span class="<%= t<=tf?'star-on':'star-off' %>">★</span><% } %></span>
                  <span class="font-bold mr-1"><%= c.rating.value %></span>
                </td>
                <td class="px-4 py-3 hidden sm:table-cell">
                  <% if (c.isActive) { %>
                    <span class="text-xs font-bold text-amber-700 bg-amber-50 border border-amber-200 rounded-full px-2 py-0.5">ویژه</span>
                  <% } else { %>
                    <span class="text-xs text-slate-400">عادی</span>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Clinic cards (premium first — already sorted by repository) -->
      <section aria-labelledby="all-clinics-heading">
        <h2 id="all-clinics-heading" class="text-xl md:text-2xl font-bold text-slate-900 mb-4">مراکز <%= service.name %> در <%= city %></h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="clinic-cards">
          <% clinics.forEach(function(c) { %>
            <%- include('_clinic-card', { c: c, premium: c.isActive }) %>
          <% }) %>
        </div>
      </section>

      <% if (districts && districts.length) { %>
        <nav class="flex flex-wrap gap-2 mt-10 pt-8 border-t border-slate-200" aria-label="جستجو بر اساس منطقه">
          <% districts.forEach(function(d) { %>
            <a href="/<%= citySlug || 'shiraz' %>/<%= service.slug %>?district=<%= d.slug %>" class="text-sm font-semibold px-3 py-2 rounded-xl bg-white border border-slate-200 hover:border-sky-400 hover:text-sky-600 transition-colors">
              <%= service.name %> در <%= d.name %>
            </a>
          <% }) %>
        </nav>
      <% } %>

    <% } %>

    <% if (seo.seoDescriptionHtml) { %>
      <section class="mt-12 md:mt-16 hub-seo-copy" aria-labelledby="hub-seo-copy-heading">
        <h2 id="hub-seo-copy-heading" class="text-xl md:text-2xl font-bold text-slate-900 mb-5">راهنمای <%= service.name %> در <%= city %></h2>
        <div class="hub-seo-prose rounded-2xl border border-slate-200 bg-white p-6 md:p-8 text-slate-700 leading-relaxed shadow-sm">
          <%- seo.seoDescriptionHtml %>
        </div>
      </section>
    <% } %>

    <!-- FAQ (visible content mirrors FAQPage JSON-LD) -->
    <section class="mt-12 md:mt-16" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-xl md:text-2xl font-bold text-slate-900 mb-5">سوالات متداول</h2>
      <div class="space-y-3">
        <% seo.faq.forEach(function(item, fi) { %>
          <details class="group rounded-2xl border border-slate-200 bg-white overflow-hidden" <%= fi === 0 ? 'open' : '' %>>
            <summary class="flex items-center justify-between gap-3 px-5 py-4 font-bold text-slate-800 cursor-pointer hover:bg-slate-50 transition-colors">
              <span><%= item.q %></span>
              <span class="text-sky-500 text-xl leading-none group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
            </summary>
            <p class="px-5 pb-4 text-slate-600 leading-relaxed border-t border-slate-100 pt-3"><%= item.a %></p>
          </details>
        <% }) %>
      </div>
    </section>

    <aside class="mt-10 rounded-2xl bg-slate-900 text-white p-6 md:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h2 class="text-lg md:text-xl font-bold mb-1">نیاز به راهنمایی دارید؟</h2>
        <p class="text-slate-300 text-sm">کارشناسان سلام دکتر بهترین مرکز <%= service.name %> را متناسب با شرایط شما معرفی می‌کنند.</p>
      </div>
      <a href="tel:+989007000462" class="inline-flex shrink-0 items-center justify-center rounded-xl bg-sky-500 hover:bg-sky-400 text-white font-bold px-6 py-3 transition-colors">تماس فوری</a>
    </aside>
  </main>

  <footer class="border-t border-slate-200 bg-slate-900 text-slate-300 py-10 mt-4">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 text-sm">
        <div>
          <h2 class="font-extrabold text-white mb-3">سلام دکتر</h2>
          <p class="leading-relaxed text-slate-400">مرجع مراکز درمانی و زیبایی <%= city %></p>
          <a href="tel:+989007000462" class="mt-3 inline-block font-bold text-sky-400 hover:text-sky-300" dir="ltr">۰۹۰۰۷۰۰۰۴۶۲</a>
        </div>
        <div>
          <h2 class="font-extrabold text-white mb-3">خدمات پرکاربرد</h2>
          <ul class="space-y-2">
            <li><a class="hover:text-white" href="/shiraz/hair-transplant">کاشت مو در شیراز</a></li>
            <li><a class="hover:text-white" href="/shiraz/botox">تزریق بوتاکس در شیراز</a></li>
            <li><a class="hover:text-white" href="/shiraz/laser-hair-removal">لیزر موهای زائد در شیراز</a></li>
            <li><a class="hover:text-white" href="/shiraz/fillers">تزریق فیلر در شیراز</a></li>
          </ul>
        </div>
        <div>
          <h2 class="font-extrabold text-white mb-3">راهنمای بیماران</h2>
          <ul class="space-y-2">
            <li><a class="hover:text-white" href="/articles.html">مقالات آموزشی</a></li>
            <li><a class="hover:text-white" href="/faq.html">سوالات متداول</a></li>
            <li><a class="hover:text-white" href="/about.html">درباره ما</a></li>
            <li><a class="hover:text-white" href="/sitemap">نقشه سایت</a></li>
          </ul>
        </div>
        <div>
          <h2 class="font-extrabold text-white mb-3">دسترسی سریع</h2>
          <ul class="space-y-2">
            <li><a class="hover:text-white" href="/">صفحه اصلی</a></li>
            <li><a class="hover:text-white" href="/search">جستجو</a></li>
            <li><a class="hover:text-white" href="/sitemap.xml">نقشه سایت XML</a></li>
          </ul>
        </div>
      </div>
      <p class="mt-8 pt-6 border-t border-slate-700 text-center text-xs text-slate-500">© 2026 سلام دکتر — مرجع مراکز درمانی و زیبایی <%= city %></p>
    </div>
  </footer>

  <script>
    (function () {
      var table = document.getElementById('clinic-table');
      if (!table) return;
      var tbody = table.querySelector('tbody');
      var headers = table.querySelectorAll('.tbl-sort');
      var sortKey = 'premium';
      var sortAsc = false;

      function getRows() {
        return Array.prototype.slice.call(tbody.querySelectorAll('tr'));
      }

      function sortRows(key, asc) {
        var rows = getRows();
        rows.sort(function (a, b) {
          if (key === 'rating') {
            return (asc ? 1 : -1) * (parseFloat(a.dataset.rating) - parseFloat(b.dataset.rating));
          }
          if (key === 'premium') {
            var p = parseInt(b.dataset.premium, 10) - parseInt(a.dataset.premium, 10);
            if (p !== 0) return p;
            return parseFloat(b.dataset.rating) - parseFloat(a.dataset.rating);
          }
          var av = (a.dataset[key] || '').localeCompare(b.dataset[key] || '', 'fa');
          return asc ? av : -av;
        });
        rows.forEach(function (r) { tbody.appendChild(r); });
      }

      headers.forEach(function (th) {
        th.addEventListener('click', function () {
          var key = th.dataset.sort;
          if (sortKey === key) sortAsc = !sortAsc;
          else { sortKey = key; sortAsc = true; }
          sortRows(key, sortAsc);
        });
      });

      sortRows('premium', false);
    })();
  </script>
</body>
</html>
