          <% }) %>
        </nav>
      <% } %>

    <% } %>

    <% if (seo.seoDescriptionHtml) { %>
      <section class="mt-12 md:mt-16 hub-seo-copy" aria-labelledby="hub-seo-copy-heading">
        <h2 id="hub-seo-copy-heading" class="text-xl md:text-2xl font-bold text-slate-900 mb-5 text-center md:text-right">راهنمای <%= service.name %> در <%= city %></h2>
