        <% seo.faq.forEach(function(item, fi) { %>
          <details <%= fi === 0 ? 'open' : '' %>>
            <summary>
              <span><%= item.q %></span>
              <span class="hub-faq__chevron" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </summary>
            <p class="hub-faq__body"><%= item.a %></p>
          </details>
        <% }) %>
      </div>
    </section>

    <aside class="mt-10 rounded-2xl bg-slate-900 text-white p-6 md:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
