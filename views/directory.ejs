      </div>
      <p class="mt-8 pt-6 border-t border-slate-700 text-center text-xs text-slate-500">© 2026 سلام دکتر — مرجع مراکز درمانی و زیبایی <%= city %></p>
    </div>
  </footer>

  <script>
    (function () {
      var table = document.getElementById('clinic-table');
      if (!table) return;
      var tbody = table.querySelector('tbody');
      var headers = table.querySelectorAll('.tbl-sort');
      var sortKey = 'premium';
      var sortAsc = false;

      function getRows() {
        return Array.prototype.slice.call(tbody.querySelectorAll('tr'));
      }

      function sortRows(key, asc) {
        var rows = getRows();
        rows.sort(function (a, b) {
          if (key === 'rating') {
            return (asc ? 1 : -1) * (parseFloat(a.dataset.rating) - parseFloat(b.dataset.rating));
          }
          if (key === 'premium') {
            var p = parseInt(b.dataset.premium, 10) - parseInt(a.dataset.premium, 10);
            if (p !== 0) return p;
            return parseFloat(b.dataset.rating) - parseFloat(a.dataset.rating);
          }
          var av = (a.dataset[key] || '').localeCompare(b.dataset[key] || '', 'fa');
          return asc ? av : -av;
        });
        rows.forEach(function (r) { tbody.appendChild(r); });
      }

      headers.forEach(function (th) {
        th.addEventListener('click', function () {
          var key = th.dataset.sort;
          if (sortKey === key) sortAsc = !sortAsc;
          else { sortKey = key; sortAsc = true; }
          sortRows(key, sortAsc);
        });
      });

      sortRows('premium', false);
    })();
  </script>
</body>
