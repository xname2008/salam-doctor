    <% } %>

    <!-- FAQ (visible content mirrors FAQPage JSON-LD) -->
    <section class="mt-12 md:mt-16" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-xl md:text-2xl font-bold text-slate-900 mb-5">سوالات متداول</h2>
