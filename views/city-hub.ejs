<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<%- include('partials/gtm-head') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#1294e0">
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>">
  <link rel="canonical" href="<%= seo.canonical %>">
  <meta name="robots" content="index, follow, max-image-preview:large">

  <meta property="og:type" content="website">
  <meta property="og:locale" content="fa_IR">
  <meta property="og:site_name" content="سلام دکتر">
  <meta property="og:title" content="<%= seo.title %>">
  <meta property="og:description" content="<%= seo.description %>">
  <meta property="og:url" content="<%= seo.canonical %>">
  <meta property="og:image" content="<%= seo.ogImage %>">

  <script type="application/ld+json"><%- seo.jsonLd %></script>

  <link rel="preload" href="/assets/fonts/IRANSansXFaNum-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/tailwind.min.css">
  <link rel="stylesheet" href="/assets/css/shared.css?v=20260903b">
  <style>
    body{font-family:"Vazirmatn","IRANSansXFaNum","Tahoma",sans-serif}
    .star-on{color:#f59e0b}.star-off{color:#e2e8f0}
    .card-premium{border:2px solid #fbbf24;background:linear-gradient(180deg,#fffbeb 0%,#fff 40%)}
  </style>
</head>
<body class="bg-slate-50 text-slate-900 antialiased">
<%- include('partials/gtm-body') %>

  <header class="topbar sticky top-0 z-50 bg-white border-b border-slate-200 shadow-sm">
    <div class="container topbar-row max-w-6xl mx-auto px-4 min-h-[68px] flex items-center justify-between gap-3">
      <a href="/index.html" class="brand flex items-center gap-2 font-extrabold text-lg text-slate-900" aria-label="سلام دکتر — صفحه اصلی">
        <span class="logo logo-heart-beat w-10 h-10 rounded-xl bg-sky-500 text-white grid place-items-center font-bold" aria-hidden="true">
          <img src="/images/logo-heart.svg" alt="" width="28" height="28" loading="eager">
        </span>
        <span class="brand-name">سلام دکتر</span>
      </a>
      <a href="tel:+989007000462" class="inline-flex items-center justify-center rounded-xl bg-sky-500 hover:bg-sky-600 text-white font-bold text-sm px-4 py-2.5 transition-colors">مشاوره رایگان</a>
    </div>
  </header>

  <section class="bg-gradient-to-b from-white to-teal-50/60 border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 py-8 md:py-10">
      <%- seo.breadcrumbHtml || '' %>
      <h1 class="text-2xl md:text-4xl font-extrabold text-slate-900 leading-tight mb-3"><%= seo.h1Title %></h1>
      <p class="text-slate-600 text-base md:text-lg max-w-3xl leading-relaxed"><%= seo.description %></p>
      <dl class="grid grid-cols-2 gap-3 md:gap-6 mt-6 max-w-md">
        <div class="bg-white rounded-xl border border-slate-200 p-3 text-center">
          <dt class="text-xs text-slate-500">خدمات</dt>
          <dd class="text-xl md:text-2xl font-bold text-sky-600"><%= stats.serviceCount %></dd>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-3 text-center">
          <dt class="text-xs text-slate-500">مراکز فعال</dt>
          <dd class="text-xl md:text-2xl font-bold text-sky-600"><%= stats.activeClinics %></dd>
        </div>
      </dl>
    </div>
  </section>

  <main class="max-w-6xl mx-auto px-4 py-8 md:py-12">
    <% if (parentServices && parentServices.length) { %>
      <section class="mb-10" aria-labelledby="parent-services-heading">
        <h2 id="parent-services-heading" class="text-xl md:text-2xl font-bold text-slate-900 mb-4">دسته‌های اصلی</h2>
        <div class="flex flex-wrap gap-2">
          <% parentServices.forEach(function(s) { %>
            <a href="<%= s.href %>" class="text-sm font-semibold px-4 py-2 rounded-full bg-white border border-slate-200 hover:border-sky-400 hover:text-sky-600 transition-colors"><%= s.name %></a>
          <% }) %>
        </div>
      </section>
    <% } %>

    <section class="mb-10" aria-labelledby="services-heading">
      <h2 id="services-heading" class="text-xl md:text-2xl font-bold text-slate-900 mb-4">خدمات پزشکی و زیبایی در <%= city %></h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <% (leafServices || services || []).forEach(function(s) { %>
          <a href="<%= s.href %>" class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-slate-800 hover:border-sky-400 hover:text-sky-600 transition-colors"><%= s.name %></a>
        <% }) %>
      </div>
    </section>

    <% if (clinics && clinics.length) { %>
      <section aria-labelledby="clinics-heading">
        <h2 id="clinics-heading" class="text-xl md:text-2xl font-bold text-slate-900 mb-4">مراکز برجسته <%= city %></h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          <% clinics.forEach(function(c) { %>
            <%- include('_clinic-card', { c: c, premium: c.isActive }) %>
          <% }) %>
        </div>
      </section>
    <% } %>
  </main>

  <footer class="bg-slate-900 text-slate-300 py-8 mt-8">
    <div class="max-w-6xl mx-auto px-4 text-center text-sm">
      <p>© سلام دکتر — راهنمای مراکز پزشکی و زیبایی <%= city %></p>
      <p class="mt-2"><a href="/sitemap" class="hover:text-white">نقشه سایت</a></p>
    </div>
  </footer>
</body>
</html>
