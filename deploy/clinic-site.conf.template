# ==========================================================================
# clinic-site.conf.template  —  dedicated per-clinic HTTPS server block.
#
# Rendered by scripts/add-clinic-domain.sh into:
#     deploy/clinic-sites.d/__CLINIC_DOMAIN__.conf
# which nginx loads via `include /etc/nginx/clinic-sites.d/*.conf;`.
#
# Placeholders (substituted by the script — safe, no special chars):
#   __CLINIC_DOMAIN__    e.g. dr-nahal.ir
#   __CLINIC_UPSTREAM__  host:port the site proxies to. Use:
#                          backend:3000        -> shared backend (multi-tenant)
#                          clinic_<slug>:3000  -> ISOLATED per-clinic container
#
# The mandatory platform backlink uses the http-level map $clinic_backlink_html
# (add a line there to give this domain a topically-relevant anchor).
# ==========================================================================

# HTTP: ACME challenge + redirect everything else to HTTPS.
server {
    listen      80;
    server_name __CLINIC_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS: dedicated clinic site.
server {
    listen      443 ssl;
    http2       on;
    server_name __CLINIC_DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__CLINIC_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CLINIC_DOMAIN__/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    include /etc/nginx/snippets/security-headers.conf;

    location / {
        proxy_pass         http://__CLINIC_UPSTREAM__;
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Clinic-Domain   $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $forwarded_proto;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   Connection        "";
        proxy_set_header   Accept-Encoding   "";   # keep body plain for sub_filter

        # --- Requirement #4: un-removable, edge-injected platform backlink ---
        sub_filter_once on;
        sub_filter_types text/html;
        sub_filter '</body>'
            '<footer class="salam-doctor-attribution" style="text-align:center;padding:16px;font:14px/1.7 Tahoma,sans-serif;background:#0f172a;color:#94a3b8">$clinic_backlink_html</footer></body>';
    }
}
