# Copy to .env.shirazbeauty and edit:
#   cp .env.shirazbeauty.example .env.shirazbeauty
#
# POSTGRES_PASSWORD and the password in DATABASE_URL must always match.

SITE_BASE="http://shirazbeauty.ir"

POSTGRES_USER="shirazbeauty"
POSTGRES_PASSWORD="change_me_strong_password"
POSTGRES_DB="shirazbeauty"

DATABASE_URL="postgresql://shirazbeauty:change_me_strong_password@shirazbeauty-db:5432/shirazbeauty?schema=public"
