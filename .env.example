# PostgreSQL connection string used by Prisma (prisma/schema.prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# If PASSWORD contains @ # : / etc., URL-encode it (e.g. Hamid@4467 → Hamid%404467).
#
# Where you RUN prisma / node:
#   On the HOST (SSH, npx prisma …):     use localhost
#   Inside a Docker CONTAINER:           use host.docker.internal
#     (Linux: compose already sets extra_hosts: host.docker.internal:host-gateway)
#     Ubuntu UFW tip if blocked:
#       sudo ufw allow from 172.16.0.0/12 to any port 5432 proto tcp
#
# Host-side default (most migrate/seed commands):
DATABASE_URL="postgresql://salam_doctor:change_me@localhost:5432/salam_doctor?schema=public"
# Container-side example (uncomment if the backend container must reach host Postgres):
# DATABASE_URL="postgresql://salam_doctor:change_me@host.docker.internal:5432/salam_doctor?schema=public"
SITE_BASE="https://salam-doctor.ir"
