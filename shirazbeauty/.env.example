# Template only — never put real secrets in this file. Copy it and edit .env:
#   cp .env.example .env
#
# POSTGRES_PASSWORD is interpolated into the API's DATABASE_URL by
# docker-compose.yml, so changing it in one place is enough. Postgres only
# applies it when initialising an empty data directory, so after changing it on
# an existing stack run: docker compose -p shirazbeauty down -v && up -d

# ---- Database -------------------------------------------------------------
POSTGRES_USER=shirazbeauty
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=shirazbeauty

# ---- API ------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3010,https://shirazbeauty.ir
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_me_with_openssl_rand_hex_32

# ---- Frontend -------------------------------------------------------------
# Inlined into the production bundle at image build time, so it must be a URL
# the visitor's browser can reach. Changing it requires an image rebuild.
NEXT_PUBLIC_API_URL=https://shirazbeauty.ir/api/v1
# Used only by the hot-reload `dev` profile container on :3011.
NEXT_PUBLIC_API_URL_DEV=http://localhost:8010/api/v1

# ---- Third-party (Phase 3 / Phase 5) --------------------------------------
# SMS gateway. Leave SMS_API_KEY empty or "mock" to print the OTP to the
# API container logs. Set a real Kavenegar key + the template name you
# created in their panel to send live messages.
SMS_PROVIDER=kavenegar
SMS_API_KEY=mock
SMS_OTP_TEMPLATE=
# Iranian official holidays source
HOLIDAYS_API_BASE=https://holidayapi.ir
