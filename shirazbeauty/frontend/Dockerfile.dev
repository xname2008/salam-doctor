# Development image with hot reload. Used by the `dev` compose profile;
# the production image is in ./Dockerfile.
FROM node:22-alpine

ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /srv

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]
